\newcommand{\cvTitle}[1]{%
	\par\vspace{0em}                   % Espacio antes (1.5em equivale a un párrafo)
	{\centering\fontsize{64pt}{38pt}\textbf{#1}\par} % Formato y el texto (#1)
	\vspace{1.5em}                         % Espacio después
}
\newcommand{\cvSubtitle}[1]{%
	\par\vspace{0em}                   % Espacio antes (equivale a un párrafo)
	{\centering\fontsize{16pt}{38pt}\textit{#1}\par} % Formato y el texto (#1)
	\vspace{1.5em}                         % Espacio después
}
% Comando para la posición general (Empresa, Tiempo General, Ubicación)
\newcommand{\cvExperience}[3]{
	\noindent \textbf{\large #1} \hfill \textbf{\small #2} \\ % Empresa y Fecha Total
	\noindent \textit{\small #3}                               % Ubicación
	\vspace{8pt}
}